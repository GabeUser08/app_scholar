{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app-scholar",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "app-scholar-db",
      "database_id": "62a2d80c-9489-4b5e-b778-f14c88de9f2c",
      "remote": true
    }
  ]
}
